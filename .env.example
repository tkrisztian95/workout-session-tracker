# PostHog product analytics (optional).
# When unset, the app skips PostHog initialization entirely.
# Project keys are public by design — safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OpenAI API key — only needed to run `npm run eval` locally.
# The app itself reads the user's key from localStorage at runtime; it is
# never read from this file in browser code.
OPENAI_API_KEY=
