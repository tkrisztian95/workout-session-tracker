# PostHog product analytics (optional).
# When unset, the app skips PostHog initialization entirely.
# Project keys are public by design — safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OpenAI API key — only needed to run `npm run eval` locally.
# Server-side only; never inlined into the browser bundle.
OPENAI_API_KEY=

# OpenAI API key for the in-app AI features (plan suggestion, exercise swap,
# plan adjust, notes import) — DEV / PREVIEW ONLY.
#
# When set, the app uses it as a fallback so you don't have to enter a key via
# Profile → AI Configuration on every fresh browser / preview URL. A saved key
# in localStorage always takes precedence.
#
# SECURITY: NEXT_PUBLIC_* vars are inlined into the client bundle and visible to
# anyone who loads the page. NEVER set NEXT_PUBLIC_OPENAI_API_KEY on the
# Production environment in Vercel. The code also refuses to use it unless
# NODE_ENV=development or NEXT_PUBLIC_VERCEL_ENV is 'preview'/'development'.
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Gemini API key for the in-app AI features — DEV / PREVIEW ONLY.
#
# Same rules as NEXT_PUBLIC_OPENAI_API_KEY: used only as a fallback when no key
# is saved in localStorage, honored only in dev/preview, never production. When
# both an OpenAI and a Gemini key are set, OpenAI takes precedence.
#
# SECURITY: NEXT_PUBLIC_* vars are inlined into the client bundle. NEVER set
# NEXT_PUBLIC_GEMINI_API_KEY on the Production environment in Vercel.
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 key for the "Import from YouTube" feature.
# Used by the /api/youtube-description server route to fetch a video's title +
# description. Free to create (no billing): Google Cloud Console → enable
# "YouTube Data API v3" → create an API key.
#
# SECURITY: this is read server-side only — it has NO NEXT_PUBLIC_ prefix, so it
# is never inlined into the browser bundle. Set it in Vercel as a regular
# (non-public) Environment Variable. Without it, the import feature returns a
# "not configured" message and the rest of the app is unaffected.
YOUTUBE_API_KEY=
