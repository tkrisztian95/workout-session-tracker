# PostHog product analytics (optional).
# When unset, the app skips PostHog initialization entirely.
# Project keys are public by design — safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# OpenAI API key — only needed to run `npm run eval` locally.
# Server-side only; never inlined into the browser bundle.
OPENAI_API_KEY=

# OpenAI API key for the in-app AI features (plan suggestion, exercise swap,
# plan adjust, notes import) — DEV / PREVIEW ONLY.
#
# When set, the app uses it as a fallback so you don't have to enter a key via
# Profile → AI Configuration on every fresh browser / preview URL. A saved key
# in localStorage always takes precedence.
#
# SECURITY: NEXT_PUBLIC_* vars are inlined into the client bundle and visible to
# anyone who loads the page. NEVER set NEXT_PUBLIC_OPENAI_API_KEY on the
# Production environment in Vercel. The code also refuses to use it unless
# NODE_ENV=development or NEXT_PUBLIC_VERCEL_ENV is 'preview'/'development'.
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini
