{
  "name": "workout-sessions-tracker",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "OPENAI_API_KEY=$OPENAI_API_KEY tsx evals/run.ts",
    "achievement-prompts": "tsx tools/generate-achievement-prompts.ts",
    "achievement-prompts:json": "tsx tools/generate-achievement-prompts.ts --json",
    "dev-seed:generate": "tsx scripts/generate-dev-seed.ts",
    "dev-seed:validate": "tsx scripts/validate-dev-seed.ts",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "next": "^16.2.11",
    "posthog-js": "^1.376.0",
    "react": "19.2.7",
    "react-dom": "19.2.5",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
